{
  "openapi": "3.1.0",
  "info": {
    "title": "VeriReview AI",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reviews": {
      "post": {
        "summary": "Review",
        "operationId": "review_api_v1_reviews_post",
        "parameters": [
          {
            "name": "x-verireview-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Verireview-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "string",
        "enum": [
          "CORRECTNESS",
          "SECURITY",
          "PERFORMANCE",
          "ERROR_HANDLING",
          "TESTING",
          "MAINTAINABILITY",
          "OBSERVABILITY",
          "ARCHITECTURE",
          "TEAM_STANDARD",
          "RELIABILITY"
        ],
        "title": "Category"
      },
      "ChangedFile": {
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512,
            "title": "Path"
          },
          "diff": {
            "type": "string",
            "maxLength": 200000,
            "title": "Diff"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "diff"
        ],
        "title": "ChangedFile"
      },
      "Coverage": {
        "properties": {
          "submitted_files": {
            "type": "integer",
            "title": "Submitted Files"
          },
          "analyzed_files": {
            "type": "integer",
            "title": "Analyzed Files"
          },
          "skipped_files": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skipped Files"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "submitted_files",
          "analyzed_files",
          "skipped_files"
        ],
        "title": "Coverage"
      },
      "Evidence": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "source": {
            "type": "string",
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "description",
          "source"
        ],
        "title": "Evidence"
      },
      "Finding": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "file_path": {
            "type": "string",
            "title": "File Path"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Start Line"
          },
          "end_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "End Line"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "why_it_matters": {
            "type": "string",
            "title": "Why It Matters"
          },
          "suggestion": {
            "type": "string",
            "title": "Suggestion"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "rule_id": {
            "type": "string",
            "title": "Rule Id"
          },
          "suggested_patch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Patch"
          },
          "verification_status": {
            "type": "string",
            "title": "Verification Status",
            "default": "POSSIBLE"
          },
          "fingerprint": {
            "type": "string",
            "title": "Fingerprint"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "file_path",
          "start_line",
          "end_line",
          "severity",
          "category",
          "title",
          "description",
          "why_it_matters",
          "suggestion",
          "confidence",
          "evidence",
          "source",
          "rule_id",
          "fingerprint"
        ],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "ai_provider": {
            "type": "string",
            "title": "Ai Provider"
          },
          "ai_configured": {
            "type": "boolean",
            "title": "Ai Configured"
          },
          "semgrep_available": {
            "type": "boolean",
            "title": "Semgrep Available"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "ai_provider",
          "ai_configured",
          "semgrep_available"
        ],
        "title": "HealthResponse"
      },
      "ReviewRequest": {
        "properties": {
          "repository": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Repository"
          },
          "branch": {
            "type": "string",
            "maxLength": 200,
            "title": "Branch"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/ChangedFile"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Files"
          },
          "minimum_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Minimum Confidence",
            "default": 0.7
          },
          "max_findings": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Findings",
            "default": 10
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "repository",
          "branch",
          "files"
        ],
        "title": "ReviewRequest"
      },
      "ReviewResponse": {
        "properties": {
          "review_id": {
            "type": "string",
            "title": "Review Id"
          },
          "repository": {
            "type": "string",
            "title": "Repository"
          },
          "branch": {
            "type": "string",
            "title": "Branch"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "files_reviewed": {
            "type": "integer",
            "title": "Files Reviewed"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          },
          "summary": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Summary"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "repository",
          "branch",
          "provider",
          "files_reviewed",
          "duration_ms",
          "summary",
          "findings",
          "coverage",
          "warnings"
        ],
        "title": "ReviewResponse"
      },
      "Severity": {
        "type": "string",
        "enum": [
          "CRITICAL",
          "HIGH",
          "MEDIUM",
          "LOW",
          "SUGGESTION"
        ],
        "title": "Severity"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
